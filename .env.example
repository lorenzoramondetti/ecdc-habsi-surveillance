# ECDC HA-BSI Surveillance Platform - Environment Configuration Example
# Copy this file to .env to override default parameters

# Server Port (default: 5050)
PORT=5050

# Ollama Endpoint (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Medical Records Directory (leave empty to use default auto-detection)
# ECDC_DATA_DIR=./sample_data

# Gold Standard Labels Path (optional)
# ECDC_GOLD_STANDARD=./sample_data/sample_gold_standard.xlsx
